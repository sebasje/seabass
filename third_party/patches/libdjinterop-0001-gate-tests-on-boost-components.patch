@@ -412,7 +412,13 @@ endif()
 # Unit tests.
 include(CTest)
 find_package(Boost 1.71.0 QUIET COMPONENTS filesystem system)
-if (Boost_FOUND)
+# Boost_FOUND alone is not enough: with CMP0167 NEW the BoostConfig package
