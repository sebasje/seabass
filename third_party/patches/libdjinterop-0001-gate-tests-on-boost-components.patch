+# with undefined references to boost::filesystem::detail::*, and the QUIET
+# above hides the one message that would have explained why. Gate on the
+# components that are actually linked.
+if (Boost_FOUND AND Boost_filesystem_FOUND AND Boost_system_FOUND)
     set(TESTDATA_DIR "${CMAKE_CURRENT_SOURCE_DIR}/testdata")
 
     function(add_djinterop_test test_dir test_name)
@@ -451,7 +457,10 @@ if (Boost_FOUND)
     add_djinterop_test(engine/v3/ track_table_test)
 
 else()
-    message(STATUS "Unit tests not available, as Boost cannot be found")
+    message(STATUS
+            "Unit tests not available, as the Boost.Filesystem and Boost.System "
+            "libraries cannot be found (the Boost headers alone are not enough; "
+            "on Debian/Ubuntu install libboost-filesystem-dev)")
 endif()
 
 
